generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  code      String             @unique(map: "organization_code_key")
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)
  orgUnits  OrgUnit[]
  accounts  Account[]
  auditLogs AuditLog[]
  numberingSequences NumberingSequence[]
  partCategories PartCategory[]
  partMasters PartMaster[]

  @@map("organization")
}

model OrgUnit {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  parentId       String?            @db.Uuid
  code           String
  name           String
  status         OrganizationStatus @default(ACTIVE)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent         OrgUnit?           @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       OrgUnit[]          @relation("OrgUnitHierarchy")
  primaryAccounts Account[]         @relation("AccountPrimaryOrgUnit")
  scopedRoleAssignments AccountRoleAssignment[] @relation("RoleAssignmentScopeOrgUnit")

  @@unique([organizationId, code], map: "org_unit_organization_id_code_key")
  @@unique([id, organizationId], map: "org_unit_id_organization_id_key")
  @@index([organizationId], map: "org_unit_organization_id_idx")
  @@index([parentId], map: "org_unit_parent_id_idx")
  @@index([status], map: "org_unit_status_idx")
  @@map("org_unit")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RoleCode {
  ADMIN
  QUALITY_MANAGER
  INSPECTOR
  ENGINEER
  VIEWER
}

model Account {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  primaryOrgUnitId  String        @db.Uuid
  username          String        @db.VarChar(128)
  normalizedUsername String       @unique(map: "account_normalized_username_key") @db.VarChar(128)
  displayName       String        @db.VarChar(200)
  passwordHash      String        @db.VarChar(512)
  status            AccountStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryOrgUnit    OrgUnit       @relation("AccountPrimaryOrgUnit", fields: [primaryOrgUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sessions          Session[]
  roleAssignments   AccountRoleAssignment[] @relation("AccountRoleAssignments")
  actorAuditLogs    AuditLog[]               @relation("AuditActorAccount")

  @@unique([id, organizationId], map: "account_id_organization_id_key")
  @@index([organizationId], map: "account_organization_id_idx")
  @@index([status], map: "account_status_idx")
  @@map("account")
}

model AccountRoleAssignment {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @db.Uuid
  organizationId  String   @db.Uuid
  role             RoleCode
  scopeOrgUnitId  String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  account          Account  @relation("AccountRoleAssignments", fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  scopeOrgUnit     OrgUnit  @relation("RoleAssignmentScopeOrgUnit", fields: [scopeOrgUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([accountId, role, scopeOrgUnitId], map: "account_role_assignment_exact_key")
  @@index([accountId, organizationId], map: "account_role_assignment_account_organization_idx")
  @@index([scopeOrgUnitId, organizationId], map: "account_role_assignment_scope_organization_idx")
  @@index([organizationId, role], map: "account_role_assignment_organization_role_idx")
  @@map("account_role_assignment")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @db.Uuid
  tokenHash  String   @unique(map: "session_token_hash_key") @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  userAgent  String?  @db.VarChar(512)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, expiresAt], map: "session_account_id_expires_at_idx")
  @@index([accountId, revokedAt], map: "session_account_id_revoked_at_idx")
  @@map("session")
}

enum AuditActorKind {
  USER
  SYSTEM
}

model AuditLog {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  actorKind         AuditActorKind
  actorAccountId   String?        @db.Uuid
  actorSessionId   String?        @db.Uuid
  requestId         String         @db.VarChar(128)
  action            String         @db.VarChar(128)
  targetType        String         @db.VarChar(128)
  targetId          String         @db.VarChar(128)
  reason            String?        @db.VarChar(500)
  details           Json?          @db.JsonB
  occurredAt        DateTime       @default(now()) @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorAccount      Account?       @relation("AuditActorAccount", fields: [actorAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, occurredAt], map: "audit_log_organization_occurred_at_idx")
  @@index([organizationId, actorAccountId, occurredAt], map: "audit_log_organization_actor_occurred_at_idx")
  @@index([organizationId, action, occurredAt], map: "audit_log_organization_action_occurred_at_idx")
  @@index([organizationId, targetType, targetId], map: "audit_log_organization_target_idx")
  @@map("audit_log")
}

enum PartCategoryStatus {
  ACTIVE
  INACTIVE
}

enum PartMasterStatus {
  ACTIVE
  INACTIVE
}

model NumberingSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  key            String       @db.VarChar(128)
  currentValue   BigInt       @default(0)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key], map: "numbering_sequence_organization_id_key_key")
  @@map("numbering_sequence")
}

model PartCategory {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  name           String             @db.VarChar(200)
  normalizedName String             @db.VarChar(200)
  description    String?            @db.VarChar(2000)
  status         PartCategoryStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  partMasters    PartMaster[]

  @@unique([organizationId, normalizedName], map: "part_category_organization_id_normalized_name_key")
  @@unique([id, organizationId], map: "part_category_id_organization_id_key")
  @@index([organizationId, status], map: "part_category_organization_id_status_idx")
  @@index([organizationId, name], map: "part_category_organization_id_name_idx")
  @@map("part_category")
}

model PartMaster {
  id                      String          @id @default(uuid()) @db.Uuid
  organizationId          String          @db.Uuid
  categoryId              String          @db.Uuid
  partNumber              String          @db.VarChar(64)
  drawingNumber           String?         @db.VarChar(200)
  normalizedDrawingNumber String?         @db.VarChar(200)
  name                    String          @db.VarChar(200)
  description             String?         @db.VarChar(2000)
  status                  PartMasterStatus @default(ACTIVE)
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(6)
  organization            Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category                PartCategory    @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, partNumber], map: "part_master_organization_id_part_number_key")
  @@unique([organizationId, normalizedDrawingNumber], map: "part_master_organization_id_normalized_drawing_number_key")
  @@unique([id, organizationId], map: "part_master_id_organization_id_key")
  @@index([organizationId, status], map: "part_master_organization_id_status_idx")
  @@index([organizationId, categoryId], map: "part_master_organization_id_category_id_idx")
  @@index([organizationId, name], map: "part_master_organization_id_name_idx")
  @@map("part_master")
}
